# beisen-webhook 健康检查告警配置 → 复制到 /etc/beisen-webhook-alert.env（root 600）
# 留空的渠道不发送；值不要加引号以外的多余空格，URL 原样粘贴即可。
WECOM_WEBHOOK=
DINGTALK_WEBHOOK=
# 钉钉安全设置选「加签」时填密钥（SEC 开头）；选「自定义关键词」时关键词填：北森
DINGTALK_SECRET=
FEISHU_WEBHOOK=
# 飞书开启「签名校验」时填密钥
FEISHU_SECRET=

# 以下可选，默认值如注释
#PUBLIC_HEALTH_URL=https://events.example.com/healthz   （默认不检查公网）
#LOCAL_HEALTH_URL=http://127.0.0.1:8600/healthz
#FEED_HEALTH_URL=http://127.0.0.1:8601/healthz
#FAIL_THRESHOLD=2
#REPEAT_MINUTES=60
