{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    }
  },

  "Beisen": {
    "BaseUrl": "https://openapi.italent.cn",
    "TokenEndpoint": "/token",
    "AppKey": "<PLACEHOLDER_APP_KEY>",
    "AppSecret": "<PLACEHOLDER_APP_SECRET>",
    "OrgTimeWindowPath": "/TenantBaseExternal/api/v5/Organization/GetByTimeWindow",
    "EmployeeTimeWindowPath": "/TenantBaseExternal/api/v5/Employee/GetByTimeWindow",
    "FullPullStartDate": "2018-01-01",
    "TimeWindowChunkDays": 90,
    "PageCapacity": 300,
    "TokenRefreshSkewSeconds": 300,
    "LogRawSamples": false,
    "EmployeeBasicByIdsPath": "/TenantBaseExternal/api/v5/Employee/GetBasicInfoByIds",
    "EmployeeServiceByIdsPath": "/TenantBaseExternal/api/v5/Employee/GetServiceInfoByIds",
    "EmployeeServiceByIdsOption": "CurrentEffectiveMainJob",
    "EmployeeExtraParams": {
      "empStatus": "[1,2,3,4,5,6,8,12]",
      "employType": "[0,2]",
      "withDisabled": "true"
    }
  },

  "ActiveDirectory": {
    "LdapHost": "dc01.example.com",
    "Port": 389,
    "UseSsl": false,
    "ServiceAccount": "EXAMPLE\\<service-account>",
    "ServicePassword": "<PLACEHOLDER_AD_PASSWORD>",
    "BaseUserOu": "OU=北森同步,DC=example,DC=com",
    "LeaverOu": "OU=离职归档,DC=example,DC=com",
    "UpnSuffix": "EXAMPLE.COM",
    "DefaultInitialPassword": "123456",
    "PasswordNeverExpires": true,
    "ForceChangePasswordAtNextLogon": false,
    "ManagedMarkerAttribute": "adminDescription",
    "ManagedMarkerValue": "beisen-sync:managed",
    "OuMarkerAttribute": "description",
    "OuMarkerPrefix": "beisen-org-id:",
    "NeverTouchOuDns": [
      "CN=Users,DC=example,DC=com",
      "CN=Builtin,DC=example,DC=com",
      "OU=Domain Controllers,DC=example,DC=com",
      "CN=Managed Service Accounts,DC=example,DC=com"
    ]
  },

  "Sync": {
    "DryRun": true,
    "RunOnceAndExit": true,
    "IncrementalIntervalMinutes": 60,
    "HourlyIncrementalEnabled": true,
    "FullSyncCron": "0 0 2 * * ?",
    "TimeWindowSafetyOffsetSeconds": 60,
    "InitialBackfillDays": 7,
    "EnsureOuTree": true,
    "ReconcileLeavers": false,
    "FullPull": false,
    "SampleLogCount": 5,
    "RootOrgId": "",
    "LeaverOrgId": "",
    "MaxLeaversPerRun": 10,
    "MaxLeaverRatio": 0.05,
    "MinPullRatioVsLastRun": 0.7,
    "TreatTransferOutAsLeaver": true,
    "TreatRetiredAsLeaver": false,
    "CreateAccountForPendingHire": true,
    "DisableLeaverEvenIfMoveFails": false,
    "DecodeHtmlEntitiesInNames": false
  },

  "EventFeed": {
    "Enabled": false,
    "Url": "",
    "Token": "",
    "PollIntervalSeconds": 15,
    "SettleSeconds": 90,
    "MaxBatchWaitSeconds": 300,
    "LookbackMinutes": 10,
    "PageSize": 200,
    "AlertAfterMinutes": 10,
    "LookupMode": "TimeWindow",
    "ByIdSettleSeconds": 10,
    "OrgCacheMinutes": 120,
    "LongPollSeconds": 25,
    "MaxMemoryMB": 512,
    "MaxPendingUserIds": 2000
  },

  "Alerts": {
    "Enabled": false,
    "MinLevel": "Warning",
    "RepeatSuppressHours": 24,
    "SendFullSyncSummary": false,
    "AlertOnDryRun": false,
    "Title": "BSTOAD 北森→AD 同步",
    "WeCom": { "Enabled": false, "Webhook": "" },
    "DingTalk": { "Enabled": false, "Webhook": "", "Secret": "" },
    "Feishu": { "Enabled": false, "Webhook": "", "Secret": "" }
  }
}
